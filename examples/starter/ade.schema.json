{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "harnesses": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "claude",
          "codex",
          "cursor",
          "grok",
          "pi"
        ]
      }
    },
    "install": {
      "type": "string",
      "enum": [
        "auto",
        "link",
        "copy"
      ]
    },
    "instructions": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "harnesses": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "cursor",
              "grok",
              "pi"
            ]
          }
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "const": "stdio"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "harnesses": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "claude",
                    "codex",
                    "cursor",
                    "grok",
                    "pi"
                  ]
                }
              },
              "overrides": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "claude",
                    "codex",
                    "cursor",
                    "grok",
                    "pi"
                  ]
                },
                "additionalProperties": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema0"
                  }
                }
              }
            },
            "required": [
              "transport",
              "command"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "const": "http"
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "harnesses": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "claude",
                    "codex",
                    "cursor",
                    "grok",
                    "pi"
                  ]
                }
              },
              "overrides": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "claude",
                    "codex",
                    "cursor",
                    "grok",
                    "pi"
                  ]
                },
                "additionalProperties": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema0"
                  }
                }
              }
            },
            "required": [
              "transport",
              "url"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "origin": {
                "type": "object",
                "properties": {
                  "git": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subdir": {
                    "type": "string"
                  },
                  "ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "git"
                ],
                "additionalProperties": false
              },
              "harnesses": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "claude",
                    "codex",
                    "cursor",
                    "grok",
                    "pi"
                  ]
                }
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "git": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "subdir": {
                "type": "string",
                "minLength": 1
              },
              "harnesses": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "claude",
                    "codex",
                    "cursor",
                    "grok",
                    "pi"
                  ]
                }
              }
            },
            "required": [
              "git"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "link": {
                "type": "string",
                "minLength": 1
              },
              "harnesses": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "claude",
                    "codex",
                    "cursor",
                    "grok",
                    "pi"
                  ]
                }
              }
            },
            "required": [
              "link"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "settings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(claude|codex|cursor|grok|pi)(:[^:\\\\]+)?$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "$ref": "#/$defs/__schema0"
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "root": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "claude",
                  "codex",
                  "cursor",
                  "grok",
                  "pi"
                ]
              },
              {
                "type": "string",
                "const": "home"
              }
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "template": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "pattern": "^[0-7]{3,4}$"
          }
        },
        "required": [
          "root",
          "target",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "secrets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "env"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "file"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "command"
              },
              "argv": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "from",
              "argv"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "const": "keychain"
              },
              "service": {
                "type": "string",
                "minLength": 1
              },
              "account": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from",
              "service",
              "account"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "https://github.com/woosal1337/ade/blob/main/schema/ade.schema.json",
  "title": "ade profile",
  "description": "The source of truth for one agent development environment."
}
